# Every setting the API reads, with the value it uses when the line is absent.
#
# Copy this to backend/.env and edit it; that file is gitignored. Nothing here is
# a secret — the blank values are the ones you fill in.
#
# Two ways it gets read, and they differ:
#
#   ./dev_payments.sh          reads backend/.env and backend/.env.local itself
#                              (a variable already in the environment wins over
#                              both). Use this for local payment work.
#
#   ./run.sh                   does NOT read the file. It runs uvicorn with
#                              whatever the process environment holds, so export
#                              the settings first:
#
#                                  set -a; . ./.env; set +a; ./run.sh
#
# A hosting provider is the same: it sets these as environment variables, and
# this file is only the list of names to set.

# --- Core -------------------------------------------------------------------

# INFO, WARNING, DEBUG...; the app's own loggers, the uploads sweep included.
LOG_LEVEL=INFO

# SQLite beside the process by default. A deployed instance usually wants either
# a persistent disk for that file or a Postgres URL; both drivers are installed.
# A file left on an ephemeral filesystem means empty tables after every deploy,
# because startup creates missing ones.
DATABASE_URL=sqlite+aiosqlite:///./iftr.db
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/iftr

# --- Who may call the API ---------------------------------------------------

# Exact origins, comma-separated: the published site and anything else that
# serves the frontend. The dev ports localhost:3000 and :5173 always work.
# Checkout also refuses an origin_url that is not in this list.
FRONTEND_ORIGINS=https://iftr.pages.dev

# One pattern for origins that cannot be listed, which is what pull request
# previews are. Name the project and anchor the end, or every preview on Pages
# is admitted: https://pr-\d+\.iftr\.pages\.dev$
FRONTEND_ORIGIN_REGEX=

# --- Sessions and encryption ------------------------------------------------

# Replace all four before the first real record. Left empty, the session key is a
# literal string in the source (anyone can mint tokens with it) and the
# encryption key is derived from an empty string and a salt that is also in the
# source. Changing ENCRYPTION_KEY or ENCRYPTION_SALT later makes the encrypted
# columns — licence numbers, plates, locations — unreadable; there is no re-key.
JWT_SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_SALT=
AUDIT_HASH_SALT=

# --- Uploads ----------------------------------------------------------------

# Where uploaded photos are stored; also served at /uploads. Defaults to
# backend/uploads, which a deployment should replace with a mounted volume —
# otherwise the records survive and the files do not.
UPLOADS_DIR=

# Minutes between sweeps of unreferenced files; 0 disables the background sweep.
UPLOADS_GC_INTERVAL_MINUTES=60

# Where the sweep writes its history. Empty means backend/logs/uploads_cleanup.log.
UPLOADS_GC_LOG=

# --- Card payments (optional) -----------------------------------------------

# With STRIPE_SECRET_KEY empty, checkout answers 503 and orders are placed
# unpaid; the rest of the app is unaffected.
STRIPE_SECRET_KEY=

# The signing secret of the endpoint Stripe calls — the Dashboard endpoint in a
# deployment, or the one `stripe listen` prints for local work. Without it the
# webhook answers 503, so only a payment made in a still-open tab is recorded.
STRIPE_WEBHOOK_SECRET=

# --- Crypto payments (optional) ---------------------------------------------

# Leave a whole wallet unset to stop offering that asset. Both are ordinary
# nodes reached over the network: a node on your own machine needs a tunnel
# before a hosted API can see it.
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_WALLET=

MONERO_WALLET_RPC_URL=
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=

# Fiat rate feed; must answer the shape app/crypto_rates.py expects.
CRYPTO_RATE_URL=https://api.coingecko.com/api/v3/simple/price

# Seconds between wallet polls; 0 disables the watcher, so confirmed payments
# stop being noticed.
CRYPTO_WATCH_INTERVAL_SECONDS=30

# How long an invoice's price is held, and how long after that it is still
# watched for a late payment.
CRYPTO_QUOTE_MINUTES=15
CRYPTO_GRACE_HOURS=24

# Below this, no crypto invoice is offered: the network fee would be a
# meaningful share of the bill.
CRYPTO_MIN_CHARGE_CENTS=100

# Block depth before a payment counts. One Bitcoin block is about ten minutes,
# one Monero block about two.
CRYPTO_BTC_CONFIRMATIONS=1
CRYPTO_XMR_CONFIRMATIONS=2

# --- Local only -------------------------------------------------------------

# Read by run.sh and dev_payments.sh, not by the app. A hosting provider gives
# the API its own bind address, usually 0.0.0.0 and the port it assigns.
HOST=127.0.0.1
PORT=8000
